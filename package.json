{
  "name": "@parthmax/flow-mcp",
  "version": "0.5.2",
  "description": "Unofficial MCP server that lets AI assistants use Google Flow (images, Veo and Omni video, upscaling) through your own signed-in Chrome. Not affiliated with Google.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "google-flow",
    "veo",
    "veo-3",
    "nano-banana",
    "gemini",
    "ai",
    "image-generation",
    "video-generation",
    "text-to-video",
    "image-to-video",
    "claude",
    "claude-code",
    "cursor",
    "vscode"
  ],
  "author": "parthmax2 <pathaksaksham430@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parthmax2/flow-mcp.git"
  },
  "homepage": "https://github.com/parthmax2/flow-mcp#readme",
  "bugs": {
    "url": "https://github.com/parthmax2/flow-mcp/issues"
  },
  "type": "module",
  "bin": {
    "flow-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CAPABILITIES.md",
    "llms.txt",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "setup": "tsx src/cli.ts setup",
    "mcp": "tsx src/server.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "chrome": "tsx src/cli.ts chrome",
    "status": "tsx src/cli.ts status",
    "capture": "tsx src/cli.ts capture",
    "image": "tsx src/cli.ts image",
    "edit": "tsx src/cli.ts edit",
    "credits": "tsx src/cli.ts credits",
    "video": "tsx src/cli.ts video",
    "watch": "tsx src/capture/watch.ts",
    "chat": "tsx src/cli.ts chat",
    "transcript": "tsx src/cli.ts transcript",
    "projects": "tsx src/cli.ts projects",
    "assets": "tsx src/cli.ts assets",
    "capabilities": "tsx src/capabilities.ts",
    "upscale": "tsx src/cli.ts upscale",
    "e2e": "tsx scripts/e2e.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
